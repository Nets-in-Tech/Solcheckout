# ===================================================================
# Solana Pay Small Business Checkout Configuration
# ===================================================================

# Server & Network Configuration
PORT=4000
NODE_ENV=development
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# PostgreSQL Database Configuration
POSTGRES_USER=solana
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=solanapay
DATABASE_URL=postgresql://solana:change_this_password@postgres:5432/solanapay

# Redis Cache & Session Configuration
REDIS_URL=redis://redis:6379

# Merchant Store Information
MERCHANT_NAME=SolRoast & Craft Co.
# Solana public key where customer payments are received (no private key needed)
MERCHANT_WALLET=your_solana_public_key_here
CORS_ORIGIN=*

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:4000
